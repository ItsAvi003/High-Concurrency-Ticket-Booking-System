# Copy to .env and adjust. .env is gitignored; this file is the documented template.

# Which settings module Django loads: config.settings.dev | config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev
# Also signs JWTs (HS256), so it must be at least 32 bytes. Generate a real one for prod:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=dev-only-insecure-key-0f3a9c2e7b1d4f6a8c0e2b4d6f8a1c3e
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Postgres container bootstrap (read by the postgres image on first start)
POSTGRES_DB=booking
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking

# How Django reaches the services. Hostnames "db" and "redis" are compose service names.
DATABASE_URL=postgres://booking:booking@db:5432/booking
REDIS_URL=redis://redis:6379/0

# JWT lifetimes
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# Logging: LOG_JSON=true emits one JSON object per line (what log aggregators want)
LOG_LEVEL=INFO
LOG_JSON=false
